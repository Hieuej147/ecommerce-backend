{
  "name": "Microservice-E-Commerce",
  "version": "0.0.1",
  "description": "Production-ready Event-Driven Microservices E-Commerce Platform",
  "author": "Danh Minh Hieu (@Hieuej147)",
  "license": "MIT",
  "scripts": {
    "build": "nest build api-gateway && nest build users && nest build agent-service && nest build catalog && nest build order && nest build payment",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:all": "concurrently -n \"CATALOG,ORDER,PAYMENT,USERS,GATEWAY\" -c \"blue,green,yellow,magenta,cyan\" \"nest start catalog\" \"nest start order\" \"nest start payment\" \"nest start users\" \"nest start api-gateway\"",
    "start:dev:all": "concurrently -k -n \"CATALOG,ORDER,PAYMENT,USERS,GATEWAY\" -c \"blue,green,yellow,magenta,cyan\" \"nest start catalog --watch\" \"nest start order --watch\" \"nest start payment --watch\" \"nest start users --watch\" \"nest start api-gateway --watch\"",
    "dev:all": "pnpm run start:dev:all",
    "dev:all:with-agent": "concurrently -k -n \"CATALOG,ORDER,PAYMENT,USERS,GATEWAY,AGENT_SVC,AGENT_PY\" -c \"blue,green,yellow,magenta,cyan,white,red\" \"nest start catalog --watch\" \"nest start order --watch\" \"nest start payment --watch\" \"nest start users --watch\" \"nest start api-gateway --watch\" \"nest start agent-service --watch\" \"cd agent-python && python main.py\"",
    "stop:db": "docker compose down",
    "stop:db:clean": "docker compose down -v",
    "start:dev": "nest start api-gateway --watch",
    "dev:webhook": "ngrok http 3000",
    "start:dev:gateway": "bash scripts/start-dev-gateway.sh",
    "start:dev:users": "nest start users --watch",
    "start:dev:agent": "nest start agent-service --watch",
    "start:dev:agent-python": "cd agent-python && .venv/bin/python main.py",
    "start:dev:catalog": "nest start catalog --watch",
    "start:dev:order": "nest start order --watch",
    "start:dev:payment": "nest start payment --watch",
    "start:dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3000/v1/inngest",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/v1/inngest",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "proto:generate": "protoc --proto_path=proto --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/contracts/src/generated --ts_proto_opt=nestJs=true,outputServices=grpc-js,esModuleInterop=true proto/*.proto",
    "db:setup": "pnpm run db:catalog:generate && pnpm run db:order:generate && pnpm run db:payment:generate && pnpm run db:users:generate && pnpm run db:agent:generate && pnpm run db:catalog:migrate && pnpm run db:users:migrate && pnpm run db:agent:migrate",
    "db:catalog:generate": "prisma generate --schema apps/catalog/prisma/schema.prisma",
    "db:catalog:migrate": "prisma migrate dev --schema apps/catalog/prisma/schema.prisma",
    "db:catalog:studio": "prisma studio --schema apps/catalog/prisma/schema.prisma",
    "db:order:generate": "prisma generate --config prisma.order.config.ts",
    "db:payment:generate": "prisma generate --config prisma.payment.config.ts",
    "db:agent:generate": "prisma generate --config prisma.agent.config.ts",
    "db:agent:migrate": "prisma migrate dev --config prisma.agent.config.ts",
    "db:agent:deploy": "prisma migrate deploy --config prisma.agent.config.ts",
    "db:users:generate": "prisma generate --config prisma.users.config.ts",
    "db:users:migrate": "prisma migrate dev --config prisma.users.config.ts",
    "db:users:deploy": "prisma migrate deploy --config prisma.users.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:seed:demo": "node scripts/seed-demo.cjs",
    "lint": "eslint \"apps/*/src/**/*.ts\" \"libs/*/src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/encoder": "^0.0.57",
    "@bufbuild/protobuf": "^2.13.0",
    "@clerk/express": "^2.1.47",
    "@copilotkit/runtime": "^1.64.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "inngest": "^4.13.0",
    "ioredis": "5.11.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.2",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.12.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/apps/.*/generated/prisma/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/generated/prisma/"
    ],
    "moduleNameMapper": {
      "^@app/contracts/(.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@app/contracts$": "<rootDir>/libs/contracts/src"
    }
  }
}
